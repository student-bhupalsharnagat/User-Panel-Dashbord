# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Base URL for the authoritative Trading Platform service (deployed on Render - accepts TRADING_PLATFORM_URL or TRADING_PLATFORM_BASE_URL)
TRADING_PLATFORM_URL="https://trading-platform-2t6r.onrender.com"

# Base URL for the Central Admin Panel service (deployed on Render - accepts CENTRAL_ADMIN_URL or CENTRAL_ADMIN_BASE_URL)
CENTRAL_ADMIN_URL="https://admin-dashbord-wxcq.onrender.com"

# HMAC Secret shared between Central Admin, Trading Platform, and User/Broker Panel (accepts INTERNAL_API_SECRET or INTERNAL_COMMUNICATION_SECRET)
INTERNAL_API_SECRET="nextrade-internal-hmac-secret-2026"

# Cryptographic secret for signing session authorization tokens
JWT_SECRET="nextrade-session-jwt-token-secret-2026"

# Environment: 'development' or 'production' (in production, demo fallbacks are disabled)
APP_ENV="production"

# Default Tenant Identifier (matches authoritative Trading Platform tenant)
DEFAULT_TENANT_ID="vertex-default"

# PostgreSQL connection string for durable persistence (Neon/Render Cloud)
# Required in production; fallback to JSON journal occurs only in local development
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Allowed CORS origins (comma-separated). Render .onrender.com domains and server host are also permitted dynamically.
ALLOWED_ORIGINS="https://trading-platform-2t6r.onrender.com,https://user-panel-dashbord-ofrt.onrender.com,https://admin-dashbord-wxcq.onrender.com,http://localhost:3000,http://localhost:5173"


