# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Base URL for the authoritative Trading Platform service (deployed on Render)
TRADING_PLATFORM_URL="https://trading-platform-3-1v13.onrender.com"

# Base URL for the Central Admin Panel service (deployed on Render)
CENTRAL_ADMIN_URL="https://admin-dashbord-2.onrender.com"

# HMAC Secret shared between Central Admin, Trading Platform, and User/Broker Panel for signed RPCs & white-label sync
INTERNAL_API_SECRET="nextrade-internal-hmac-secret-2026"

# Cryptographic secret for signing session authorization tokens
JWT_SECRET="nextrade-session-jwt-token-secret-2026"

# Environment: 'development' or 'production' (in production, demo fallbacks are disabled)
APP_ENV="development"

# Default Tenant Identifier
DEFAULT_TENANT_ID="TENANT-NEXTRADE-01"
